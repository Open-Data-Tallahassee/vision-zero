# Copy to .env.local and fill in. Never commit real values.

# Mapbox public token, restricted by URL in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Where crash data comes from: "file" (data/ in this repo) or "postgres" (later).
CRASH_SOURCE=file

# Neon Postgres (Phase 7)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Community pathways. Leave unset to keep each one switched off.
ENABLE_CITY_REQUESTS=
ENABLE_DATA_REQUESTS=
DONATION_URL=
